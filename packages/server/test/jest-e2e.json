{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "auth.e2e-spec.ts$",
  "setupFiles": ["<rootDir>/jest-setup-emitwarning.js"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/../src/$1"
  },
  "maxWorkers": 1,
  "maxConcurrency": 1
}
